<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds ("Aurora Dev") live beside an installed release: they never offer themselves as the Home
     app, have no Home-button service, do not start at boot and add no second AirPlay tile. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity android:name="app.hermes.aurora.MainActivity">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name="io.github.jqssun.airplay.MainActivity">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name="app.hermes.aurora.HomeGuardService" tools:node="remove" />
        <receiver android:name="io.github.jqssun.airplay.BootReceiver" tools:node="remove" />
    </application>
</manifest>
